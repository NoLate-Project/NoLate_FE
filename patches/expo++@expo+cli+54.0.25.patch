--- /dev/null
+++ b/node_modules/expo/node_modules/@expo/cli/build/src/start/doctor/apple/simulatorApplication.js
@@ -0,0 +1,28 @@
+"use strict";
+const fs = require('node:fs');
+const path = require('node:path');
+const spawnAsync = require('@expo/spawn-async');
+
+// Xcode 27 moved the simulator UI to Contents/Applications/DeviceHub.app.
+// Resolve against the selected Xcode so multiple installations remain usable.
+async function getSimulatorApplicationAsync() {
+    let developerDir = process.env.DEVELOPER_DIR;
+    if (!developerDir) {
+        developerDir = (await spawnAsync('xcode-select', ['--print-path'])).stdout.trim();
+    }
+    if (developerDir.endsWith('.app')) {
+        developerDir = path.join(developerDir, 'Contents', 'Developer');
+    }
+    for (const appPath of [
+        path.join(developerDir, 'Applications', 'Simulator.app'),
+        path.resolve(developerDir, '..', 'Applications', 'DeviceHub.app'),
+        path.join(developerDir, 'Applications', 'DeviceHub.app'),
+    ]) {
+        const plist = path.join(appPath, 'Contents', 'Info.plist');
+        if (!fs.existsSync(plist)) continue;
+        const bundleId = (await spawnAsync('/usr/bin/plutil', ['-extract', 'CFBundleIdentifier', 'raw', '-o', '-', plist])).stdout.trim();
+        return { appPath, bundleId, processName: appPath.endsWith('DeviceHub.app') ? 'DeviceHub' : 'Simulator' };
+    }
+    return null;
+}
+exports.getSimulatorApplicationAsync = getSimulatorApplicationAsync;
