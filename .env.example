EXPO_PUBLIC_MAP_PROVIDER=TMAP
# 배포 빌드에서 사용하는 운영 API 주소
EXPO_PUBLIC_API_BASE_URL=https://nolate.jinuk.dev
# 운영 앱은 대중교통 경로를 서버에서 조회해 TMAP 키와 provider 장애를 앱 밖에서 관리한다.
EXPO_PUBLIC_ROUTE_API_PROXY_ENABLED=true
# 개발 빌드는 iOS Simulator 127.0.0.1:5522, Android Emulator 10.0.2.2:5522를 자동 사용한다.
# 실제 휴대폰으로 로컬 BE에 연결할 때만 아래 값을 Mac의 LAN IP로 지정한다.
# EXPO_PUBLIC_LOCAL_API_BASE_URL=http://YOUR_MAC_LAN_IP:5522
# 지도 렌더 SDK를 네이버로 유지할 경우에만 사용 (현재 앱 설정 기준)
# EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID
# EXPO_PUBLIC_NAVER_MAP_CLIENT_SECRET=YOUR_NAVER_MAP_CLIENT_SECRET

# Tmap Open API 앱키 (로컬 direct fallback과 지도 SDK용)
# - 주소 검색(POI): /tmap/pois
# - 정방향 지오코딩: /tmap/geo/fullAddrGeo
# - 역지오코딩: /tmap/geo/reversegeocoding
# - 자차 경로: /tmap/routes
# - 도보 경로: /tmap/routes/pedestrian
# - 대중교통 경로: /transit/routes
EXPO_PUBLIC_TMAP_APP_KEY=YOUR_TMAP_APP_KEY

# ODsay 모바일 플랫폼 키
# Android/iOS 키는 서로 바꿔 쓰지 않으며 등록한 Package Name/Bundle ID 빌드에서만 사용한다.
EXPO_PUBLIC_ODSAY_ANDROID_API_KEY=YOUR_ODSAY_ANDROID_API_KEY
EXPO_PUBLIC_ODSAY_IOS_API_KEY=YOUR_ODSAY_IOS_API_KEY

# SNS Login
# - 네이버 지도/검색 Client ID가 아니라 "네아로" 애플리케이션의 Client ID/Secret을 넣어야 합니다.
# - 네이버 개발자 콘솔의 iOS URL Scheme도 아래 값과 같아야 합니다.
# EXPO_PUBLIC_NAVER_CONSUMER_KEY=YOUR_NAVER_LOGIN_CLIENT_ID
# EXPO_PUBLIC_NAVER_CONSUMER_SECRET=YOUR_NAVER_LOGIN_CLIENT_SECRET
# EXPO_PUBLIC_NAVER_APP_NAME=NoLate
# EXPO_PUBLIC_NAVER_SERVICE_URL_SCHEME_IOS=nolate-naver
