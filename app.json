{
  "name": "NoLate",
  "icon": "./assets/icon.png",
  "version": "1.2.0",
  "scheme": "nolate",
  "orientation": "portrait",
  "userInterfaceStyle": "automatic",
  "plugins": [
    "expo-router",
    "expo-secure-store",
    "expo-apple-authentication",
    "@react-native-firebase/app",
    "@react-native-firebase/messaging",
    "@react-native-community/datetimepicker",
    [
      "expo-location",
      {
        "locationWhenInUsePermission": "NoLate에서 현재 위치를 출발지로 설정하기 위해 위치 권한이 필요합니다."
      }
    ],
    [
      "@react-native-seoul/kakao-login",
      {
        "kakaoAppKey": "9586a8e3a28f3a6fbe3e23b9b34ec206",
        "kotlinVersion": "2.1.20"
      }
    ],
    [
      "@react-native-seoul/naver-login",
      {
        "urlScheme": "nolate-naver"
      }
    ],
    [
      "expo-build-properties",
      {
        "android": {
          "usesCleartextTraffic": false,
          "extraMavenRepos": [
            "https://devrepo.kakao.com/nexus/content/groups/public/"
          ]
        },
        "ios": {
          "deploymentTarget": "16.6"
        }
      }
    ],
    [
      "expo-image-picker",
      {
        "photosPermission": "NoLate에서 사진 속 일정 정보를 불러오기 위해 사진 보관함 권한이 필요합니다.",
        "cameraPermission": "NoLate에서 사진을 촬영해 빠른 일정을 만들기 위해 카메라 권한이 필요합니다.",
        "microphonePermission": false
      }
    ],
    "expo-web-browser"
  ],
  "android": {
    "package": "com.anonymous.nolate_fe",
    "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nolate.jinuk.dev",
              "pathPrefix": "/share/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CALENDAR",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "blockedPermissions": []
  },
  "ios": {
    "bundleIdentifier": "com.anonymous.nolatefe",
    "buildNumber": "47",
    "associatedDomains": [
      "applinks:nolate.jinuk.dev"
    ],
    "googleServicesFile": "./ios/GoogleService-Info.plist",
    "entitlements": {
      "aps-environment": "$(APS_ENVIRONMENT)",
      "com.apple.developer.usernotifications.time-sensitive": true,
      "keychain-access-groups": [
        "$(AppIdentifierPrefix)com.anonymous.nolatefe"
      ]
    },
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "KAKAO_APP_SCHEME": "kakao9586a8e3a28f3a6fbe3e23b9b34ec206",
      "NSAlarmKitUsageDescription": "추천 출발 시각을 놓치지 않도록 출발 알람을 울립니다.",
      "NSLocationWhenInUseUsageDescription": "NoLate에서 현재 위치를 출발지로 설정하기 위해 위치 권한이 필요합니다.",
      "NSCalendarsUsageDescription": "NoLate에서 캘린더 일정을 가져와 출발 알림을 준비하기 위해 캘린더 접근 권한이 필요합니다.",
      "NSCalendarsFullAccessUsageDescription": "NoLate에서 선택한 캘린더 일정을 가져와 출발 알림을 준비하기 위해 전체 캘린더 접근 권한이 필요합니다.",
      "NSRemindersUsageDescription": "NoLate의 캘린더 연동 기능을 제공하기 위해 미리 알림 접근 권한 설명이 필요합니다.",
      "NSRemindersFullAccessUsageDescription": "NoLate의 캘린더 연동 기능을 제공하기 위해 미리 알림 전체 접근 권한 설명이 필요합니다.",
      "NSCameraUsageDescription": "NoLate에서 사진을 촬영해 빠른 일정을 만들기 위해 카메라 권한이 필요합니다.",
      "NSPhotoLibraryUsageDescription": "NoLate에서 사진 속 일정 정보를 불러오기 위해 사진 보관함 권한이 필요합니다.",
      "NSMicrophoneUsageDescription": "NoLate에서 음성으로 빠른 일정을 만들기 위해 마이크 권한이 필요합니다.",
      "NSSpeechRecognitionUsageDescription": "NoLate에서 음성을 텍스트로 변환해 빠른 일정을 만들기 위해 음성 인식 권한이 필요합니다.",
      "LSApplicationQueriesSchemes": [
        "kakaokompassauth",
        "storykompassauth",
        "kakaolink",
        "naversearchapp",
        "naversearchthirdlogin"
      ],
      "UIBackgroundModes": [
        "remote-notification"
      ],
      "NSAppTransportSecurity": {
        "NSAllowsLocalNetworking": true
      }
    }
  }
}
