# Copy this file to android/keystore.properties (which is gitignored), or use
# the same names as environment variables in CI. Never commit the real values.
NOLATE_ANDROID_STORE_FILE=/absolute/path/to/nolate-upload.jks
NOLATE_ANDROID_STORE_PASSWORD=replace-me
NOLATE_ANDROID_KEY_ALIAS=nolate-upload
NOLATE_ANDROID_KEY_PASSWORD=replace-me
