export NODE_BINARY=$(command -v node)

# Keep Xcode's ordinary iOS Release/Archive bundle in sync with the native
# product entitlements. The location engine still requires a saved route,
# member consent, and authenticated server admission before it can run.
if [[ "${CONFIGURATION:-}" == "Release" ]]; then
  export EXPO_PUBLIC_JOURNEY_GUIDANCE_ENABLED=true
  export EXPO_PUBLIC_JOURNEY_PRODUCT_ENABLED=true
  export EXPO_PUBLIC_AUTOMATIC_JOURNEY_AUTHENTICATED_ENABLED=true
  export NOLATE_JOURNEY_PRODUCT_BUILD=1
  export EXPO_PUBLIC_AUTOMATIC_JOURNEY_DEVICE_FIELD_TEST_ENABLED=false
fi
